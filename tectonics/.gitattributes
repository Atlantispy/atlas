# Explicit LF for this new source package; no old file is renormalised.
*.py text eol=lf
*.md text eol=lf
*.json text eol=lf
*.toml text eol=lf
*.jl text eol=lf
*.txt text eol=lf
# Retained test logs are already stored with LF and bound by recorded digests.
*.log text eol=lf

# Preserve pinned reference bytes; Git must not normalise their line endings.
reference_data/** -text

# Preserve the exact new pressure runtime input-selection bytes and their pin.
optimisation/workbench/plan40/pressure/implementation/runtime/selection.json -text whitespace=cr-at-eol
# Preserve exact new heat receipts/bound inputs, including Windows JSON newlines.
# These rules live here so this package's general JSON rule cannot override them.
optimisation/workbench/plan40/heat/testing/**/*.json -text whitespace=cr-at-eol
optimisation/workbench/plan40/heat/implementation-r1/**/*.json -text whitespace=cr-at-eol
