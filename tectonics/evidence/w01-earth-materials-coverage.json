  "source_scopes": [
    {
      "id": "ANDUJAR2016",
      "citation": "And\u00fajar M\u00e1rquez, Mart\u00ednez Boh\u00f3rquez and G\u00f3mez Melgar (2016), Sensors 16, 306; doi:10.3390/s16030306",
      "scope": "Table 1 thermal conductivity reference values. Rock-class typical values, not calibrated mantle-temperature laws. Actual pore state and exact measurement conditions are not resolved by this compilation.",
      "url": "https://www.mdpi.com/1424-8220/16/3/306"
    },
    {
      "id": "BANKS2025",
      "citation": "Banks (2025), porosity and saturation effects; doi:10.47248/ges2505030007",
      "scope": "Bulk volumetric heat capacity is volume-weighted. Conductivity depends on geometry/saturation; geometric mixing is not universally valid for dry porous material. Conductivity bounds and explicit structure selection are retained.",
      "url": "https://eprints.gla.ac.uk/365772/"
    },
    {
      "id": "BURNMAN",
      "citation": "BurnMan composite and averaging-scheme documentation",
      "scope": "Distinguishes mass, mole and volume fractions and properties evaluated at a thermodynamic state. Method reference only; no BurnMan code/database is bundled.",
      "url": "https://burnman.readthedocs.io/en/latest/materials_05_composite.html"
    },
    {
      "id": "GOTO2008",
      "citation": "Goto and Matsubayashi (2008), JGR; doi:10.1029/2007JB005119",
      "scope": "Table 3, room-condition constituent values, with upstream references and calculated entries. 293.15 K is the library nominal room reference, not a claim of identical experimental temperatures.",
      "url": "https://agupubs.onlinelibrary.wiley.com/doi/full/10.1029/2007JB005119"
    },
    {
      "id": "HASTEROK2018",
      "citation": "Hasterok, Gard and Webb (2018), Geoscience Frontiers 9, 1777\u20131794; doi:10.1016/j.gsf.2017.10.012",
      "scope": "Author-posted preprint, section 5.3: aluminous shale 2.9 and iron-rich shale 1.7 microW/m3. Population representatives, not universal source rates or cooling ages.",
      "url": "https://www.researchgate.net/publication/321043977_On_the_radiogenic_heat_production_of_metamorphic_igneous_and_sedimentary_rocks"
    },
    {
      "id": "HUOTARI2004",
      "citation": "Huotari and Kukkonen (2004), Posiva Working Report 2004-04, Geological Survey of Finland",
      "scope": "Full report mirror, Table 3, Dane (1942) population values over 20\u2013100 \u00b0C. Linear coefficients converted to volumetric by 3 only under the explicitly assumed isotropic reference. Not a tensor or a temperature-dependent law.",
      "url": "https://studylib.net/doc/8402570/thermal-expansion-properties-of-rocks"
    },
    {
      "id": "KAKOKO2023",
      "citation": "Kakoko, Jande et al. (2023), ACS Omega 8, 18554\u201318565; doi:10.1021/acsomega.3c00314",
      "scope": "Table 3, literature compilation at 20 \u00b0C. Factual values only; no article text or illustrations distributed. Natural ranges are not confidence intervals or a matched specimen.",
      "url": "https://pubs.acs.org/doi/10.1021/acsomega.3c00314"
    },
    {
      "id": "LEE2015",
      "citation": "Lee, Park, Park and Park (2015), Tunnel and Underground Space 25(1), 1\u201323; doi:10.7474/TUS.2015.25.1.001",
      "scope": "Author-posted full report. Tables 1/2/5/6/7/8. Table 8 credits Waples and Waples (2004); table 5 credits Skinner/Robie/Robertson. Table 1 heat capacities mostly at 0 \u00b0C; table 5 expansion is a 20\u2013400 \u00b0C secant, NOT instantaneous room-temperature expansion. Ambiguous and anomalous rows are excluded.",
      "url": "https://www.researchgate.net/publication/277645110_Current_Status_of_Research_on_Thermal_and_Mechanical_Properties_of_Rock_under_High-Temperature_Condition"
    },
    {
      "id": "RYBACH2023",
      "citation": "Application of in-situ gamma spectrometry (2023), Geothermal Energy; doi:10.1186/s40517-023-00273-3",
      "scope": "Equation 2 reproduces the Rybach model: microW/m3 = rho[kg/m3]*1e-5*(9.52 U[ppm]+2.56 Th[ppm]+3.48 K[wt%]). The published prose omits the coefficient scalings; this library follows the dimensioned equation. Natural present-day isotope mixture, not radioactive evolution.",
      "url": "https://link.springer.com/article/10.1186/s40517-023-00273-3"
    },
    {
      "id": "WATER2019",
      "citation": "Evaluation of Heat Transfer Performance of a Multi-Disc Sorption Bed (2019), Energies 12, 4660; doi:10.3390/en12244660",
      "scope": "Table 2 liquid-water model inputs. 20 \u00b0C is an explicit nominal reference for this rounded engineering set, not a full IAPWS equation of state.",
      "url": "https://www.mdpi.com/1996-1073/12/24/4660"
    },
    {
      "id": "WATER2024",
      "citation": "Vukeli\u0107 and \u0160porin (2024), Groundwater Potential for the Utilisation of Shallow Geothermal Energy from a Closed Coal Mine, Water 16, 1572; doi:10.3390/w16111572",
      "scope": "Table 6 ranges used only for shale and gypsum conductivity, and stated ice reference. Excludes inconsistent air density and reversed sand heat-capacity range in this table.",
      "url": "https://www.mdpi.com/2073-4441/16/11/1572"
    }
