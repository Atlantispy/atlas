{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://diadem.invalid/schemas/benchmark-v1",
  "type": "object",
  "required": ["schema", "benchmark_id", "task", "environment", "identical_inputs", "reference", "candidate", "comparison", "status"],
  "properties": {
    "schema": {"const": "diadem.engineering.benchmark.v1"},
    "benchmark_id": {"type": "string", "minLength": 1},
    "task": {"type": "object"},
    "environment": {"type": "object"},
    "identical_inputs": {"const": true},
    "reference": {"$ref": "#/$defs/pathMeasurement"},
    "candidate": {"$ref": "#/$defs/pathMeasurement"},
    "comparison": {"type": "object", "required": ["artifact_family", "parity_pass", "parity_report_fingerprint", "end_to_end_gain_fraction", "resource_limits_pass"]},
    "status": {"enum": ["PASS", "FAIL"]}
  },
  "$defs": {
    "metrics": {
      "type": "object",
      "$comment": "The executable validator enforces that NOT_MEASURABLE values are null and MEASURED/ESTIMATED values are non-negative integers; zero must never stand in for unknown.",
      "required": ["wall_seconds", "cpu_seconds", "peak_ram_bytes", "disk_read_bytes", "disk_write_bytes", "files_opened", "data_read_bytes", "output_bytes", "context_bytes", "estimated_context_tokens", "disk_read_operations", "disk_write_operations", "measurement_methods"],
      "properties": {
        "wall_seconds": {"type": "number", "minimum": 0},
        "cpu_seconds": {"type": "number", "minimum": 0},
        "peak_ram_bytes": {"type": "integer", "minimum": 0},
        "disk_read_bytes": {"type": "integer", "minimum": 0},
        "disk_write_bytes": {"type": "integer", "minimum": 0},
        "files_opened": {"type": "integer", "minimum": 0},
        "data_read_bytes": {"type": "integer", "minimum": 0},
        "output_bytes": {"type": "integer", "minimum": 0},
        "context_bytes": {"type": ["integer", "null"], "minimum": 0},
        "estimated_context_tokens": {"type": ["integer", "null"], "minimum": 0},
        "disk_read_operations": {"type": ["integer", "null"], "minimum": 0},
        "disk_write_operations": {"type": ["integer", "null"], "minimum": 0},
        "measurement_methods": {
          "type": "object",
          "required": ["context_bytes", "estimated_context_tokens", "disk_read_operations", "disk_write_operations"],
          "properties": {
            "context_bytes": {"$ref": "#/$defs/measurementMethod"},
            "estimated_context_tokens": {"$ref": "#/$defs/measurementMethod"},
            "disk_read_operations": {"$ref": "#/$defs/measurementMethod"},
            "disk_write_operations": {"$ref": "#/$defs/measurementMethod"}
          },
          "additionalProperties": false
        }
      }
    },
    "measurementMethod": {
      "type": "object",
      "required": ["basis", "method"],
      "properties": {
        "basis": {"enum": ["MEASURED", "ESTIMATED", "NOT_MEASURABLE"]},
        "method": {"type": "string", "minLength": 1}
      },
      "additionalProperties": false
    },
    "pathMeasurement": {
      "type": "object",
      "required": ["path_id", "runs", "metrics", "output_fingerprints"],
      "properties": {
        "path_id": {"type": "string"},
        "runs": {"type": "integer", "minimum": 3},
        "metrics": {"$ref": "#/$defs/metrics"},
        "output_fingerprints": {"type": "array", "minItems": 1, "items": {"type": "string", "pattern": "^dgh:v1:"}}
      }
    }
  }
}
